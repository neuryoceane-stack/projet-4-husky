---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout 
  title="Calendrier - Administration Chalet Husky"
  description="Gestion des réservations et prix par semaine"
  currentPage="calendrier"
>
  <section class="admin-section">
    <div class="container">
      <div class="cal-header">
        <div>
          <p class="cal-label">Saison</p>
          <h1 id="currentYear">Hiver 25/26</h1>
        </div>
        <div class="cal-nav">
          <button id="prevYear" class="btn btn-secondary">← Précédent</button>
          <button id="nextYear" class="btn btn-secondary">Suivant →</button>
        </div>
      </div>

      <div class="cal-kpis" id="calKpis">
        <div class="kpi-card">
          <p class="kpi-label">Revenus</p>
          <p class="kpi-value" id="kpiRevenu">—</p>
        </div>
        <div class="kpi-card">
          <p class="kpi-label">Occupation</p>
          <p class="kpi-value" id="kpiOccupation">—</p>
        </div>
        <div class="kpi-card">
          <p class="kpi-label">Réservations</p>
          <p class="kpi-value" id="kpiReservations">—</p>
        </div>
      </div>

      <div class="cal-table-wrap">
        <table class="cal-table" id="calendarTable">
          <thead>
            <tr>
              <th class="col-semaine">Semaine</th>
              <th class="col-tarif">Tarif TTC</th>
              <th class="col-plateforme">Plateforme</th>
              <th class="col-etat">État</th>
              <th class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody id="calendarBody">
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Modal Fiche Locataire -->
  <div id="tenantModal" class="tenant-modal" style="display: none;">
    <div class="tenant-modal-content">
      <div class="tenant-modal-header">
        <h2>Fiche Locataire</h2>
        <button class="tenant-modal-close" id="closeTenantModal">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="tenant-modal-body">
        <form id="tenantForm">
          <div class="form-group">
            <label for="tenantNom">Nom</label>
            <input type="text" id="tenantNom" name="nom" class="form-input">
          </div>
          <div class="form-group">
            <label for="tenantPrenom">Prénom</label>
            <input type="text" id="tenantPrenom" name="prenom" class="form-input">
          </div>
          <div class="form-group">
            <label for="tenantNationalite">Nationalité</label>
            <input type="text" id="tenantNationalite" name="nationalite" class="form-input">
          </div>
          <div class="form-group">
            <label for="tenantEmail">Email</label>
            <input type="email" id="tenantEmail" name="email" class="form-input">
          </div>
          <div class="form-group">
            <label for="tenantTelephone">Numéro de téléphone</label>
            <input type="tel" id="tenantTelephone" name="telephone" class="form-input">
          </div>
          <div class="form-group">
            <label for="tenantNote">Note</label>
            <textarea id="tenantNote" name="note" class="form-textarea" rows="4"></textarea>
          </div>
          <div class="tenant-modal-actions">
            <button type="button" class="btn btn-secondary" id="cancelTenantForm">Annuler</button>
            <button type="submit" class="btn btn-primary">Enregistrer</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div id="crmLinkModal" style="display:none;position:fixed;inset:0;z-index:1100;
    align-items:center;justify-content:center;padding:1rem;
    background:rgba(15,37,64,0.4);">
    <div style="background:#fff;border-radius:14px;max-width:460px;width:100%;
      max-height:90vh;overflow-y:auto;
      box-shadow:0 12px 40px rgba(0,0,0,0.15);">
      <div style="display:flex;justify-content:space-between;align-items:center;
        padding:1.25rem 1.5rem;border-bottom:1px solid #e8e6e3;background:#faf9f7;
        border-radius:14px 14px 0 0;">
        <h3 id="crmModalTitle" style="margin:0;font-size:1rem;font-weight:700;
          color:#1e3a5f;">Fiche client</h3>
        <button type="button" id="crmModalClose" style="background:#e8e6e3;border:none;
          border-radius:8px;width:32px;height:32px;cursor:pointer;font-size:1rem;
          display:flex;align-items:center;justify-content:center;">✕</button>
      </div>
      <div id="crmModalBody" style="padding:1.5rem;">
        <p style="color:#9ca3af;font-style:italic;">Chargement...</p>
      </div>
      <div style="padding:1rem 1.5rem;border-top:1px solid #e8e6e3;
        background:#faf9f7;display:flex;justify-content:flex-end;
        border-radius:0 0 14px 14px;">
        <a href="/admin/crm" style="display:inline-flex;align-items:center;
          gap:0.5rem;padding:0.6rem 1.25rem;background:#1e3a5f;color:#fff;
          border-radius:8px;text-decoration:none;font-size:0.875rem;
          font-weight:600;">
          Ouvrir le CRM complet →
        </a>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  :global(body) {
    font-family: Calibri, 'Gill Sans', 'Gill Sans MT', 'Trebuchet MS', sans-serif;
  }

  .admin-section {
    padding: 2rem 0 4rem;
    min-height: calc(100vh - 56px);
    background: #f5f4f1;
  }

  .container {
    max-width: 1050px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* HEADER */
  .cal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cal-label {
    font-size: 11px;
    font-weight: 600;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 4px;
  }

  .cal-header h1 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0f2540;
    margin: 0;
  }

  .cal-nav {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .cal-nav .btn {
    padding: 6px 16px;
    font-size: 13px;
    font-family: inherit;
    background: white;
    border: 1px solid #e0ddd8;
    border-radius: 8px;
    color: #0f2540;
    cursor: pointer;
    font-weight: 600;
    transition: background 0.15s;
  }

  .cal-nav .btn:hover {
    background: #f5f4f1;
  }

  /* KPI CARDS */
  .cal-kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 1.25rem;
  }

  .kpi-card {
    background: white;
    border: 0.5px solid #e8e6e3;
    border-radius: 10px;
    padding: 1rem 1.25rem;
  }

  .kpi-label {
    font-size: 11px;
    font-weight: 600;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 6px;
  }

  .kpi-value {
    font-size: 22px;
    font-weight: 700;
    color: #0f2540;
    margin: 0;
  }

  /* TABLE */
  .cal-table-wrap {
    background: white;
    border: 0.5px solid #e8e6e3;
    border-radius: 12px;
    overflow: hidden;
  }

  .cal-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .cal-table thead tr {
    border-bottom: 0.5px solid #e8e6e3;
  }

  .cal-table th {
    padding: 10px 16px;
    font-size: 11px;
    font-weight: 600;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    background: white;
    text-align: left;
  }

  .col-tarif { text-align: right !important; }
  .col-actions { text-align: center !important; }

  .cal-table tbody tr {
    border-bottom: 0.5px solid #f5f3f0;
    transition: filter 0.1s;
  }

  .cal-table tbody tr:last-child {
    border-bottom: none;
  }

  .cal-table td {
    padding: 11px 16px;
    vertical-align: middle;
    color: #4b5563;
  }

  /* COULEURS PAR ÉTAT */
  .cal-table tbody tr.row-reserved { background: #fff1f2; }
  .cal-table tbody tr.row-reserved td { background: #fff1f2; }
  .cal-table tbody tr.row-reserved:hover { background: #ffe4e6; }
  .cal-table tbody tr.row-reserved:hover td { background: #ffe4e6; }

  .cal-table tbody tr.row-available { background: #f0fdf4; }
  .cal-table tbody tr.row-available td { background: #f0fdf4; }
  .cal-table tbody tr.row-available:hover { background: #dcfce7; }
  .cal-table tbody tr.row-available:hover td { background: #dcfce7; }

  .cal-table tbody tr.row-privatized { background: #fff7ed; }
  .cal-table tbody tr.row-privatized td { background: #fff7ed; }
  .cal-table tbody tr.row-privatized:hover { background: #ffedd5; }
  .cal-table tbody tr.row-privatized:hover td { background: #ffedd5; }

  /* Forcer les fonds par état (priorité sur styles inline / autres règles) */
  .row-reserved, .row-reserved td { background-color: #fff1f2 !important; }
  .row-reserved:hover td { background-color: #ffe4e6 !important; }
  .row-available, .row-available td { background-color: #f0fdf4 !important; }
  .row-available:hover td { background-color: #dcfce7 !important; }
  .row-privatized, .row-privatized td { background-color: #fff7ed !important; }
  .row-privatized:hover td { background-color: #ffedd5 !important; }

  .cal-table tbody tr:not(.row-reserved):not(.row-available):not(.row-privatized):not(.total-row):hover td {
    background: #faf9f7;
  }

  /* CELLULE SEMAINE */
  .cell-semaine {
    font-weight: 600;
    font-size: 13px;
    color: #0f2540;
  }

  .row-reserved .cell-semaine { color: #9f1239; }
  .row-available .cell-semaine { color: #166534; }
  .row-privatized .cell-semaine { color: #9a3412; }

  /* CELLULE TARIF */
  .cell-tarif {
    text-align: right;
    font-weight: 600;
    color: #0f2540;
  }

  /* INPUTS */
  .price-input {
    width: 100%;
    max-width: 120px;
    margin-left: auto;
    padding: 0.3rem 0.5rem;
    border: none !important;
    border-bottom: 1.5px solid transparent !important;
    background: transparent !important;
    text-align: right;
    font-size: 13px;
    font-weight: 600;
    font-family: inherit;
    color: #0f2540;
    transition: border-color 0.2s;
    display: block;
  }

  .price-input:focus {
    outline: none;
    border-bottom-color: #0f2540;
  }

  .price-input[readonly] { cursor: default; }

  /* SELECTS */
  .calendar-select {
    width: 100%;
    max-width: 155px;
    padding: 0.3rem 0.5rem;
    border: none;
    background: transparent;
    font-size: 13px;
    font-family: inherit;
    color: #6b7280;
    cursor: default;
    appearance: none;
    -webkit-appearance: none;
    display: block;
  }

  .calendar-select:not(:disabled) {
    background: #f5f4f1;
    border: 1px solid #e0ddd8;
    border-radius: 6px;
    cursor: pointer;
    color: #0f2540;
  }

  .calendar-select:focus {
    outline: none;
    border-color: #0f2540;
  }

  /* BADGES ÉTAT */
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .badge-reserved { background: #ffe4e6; color: #9f1239; }
  .badge-available { background: #dcfce7; color: #166534; }
  .badge-privatized { background: #ffedd5; color: #9a3412; }
  .badge-empty { color: #9ca3af; font-size: 13px; }

  /* BOUTONS ACTION */
  .action-cell {
    text-align: center;
    padding: 8px 16px;
  }

  .action-btns {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    justify-content: center;
  }

  .btn-action {
    background: #f5f4f1;
    border: 1px solid #e0ddd8;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    font-family: inherit;
    color: #4b5563;
    cursor: pointer;
    font-weight: 500;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
  }

  .btn-action:hover {
    background: #0f2540;
    color: white;
    border-color: #0f2540;
  }

  .btn-action-green { color: #166534; border-color: #bbf7d0; background: #f0fdf4; }
  .btn-action-green:hover { background: #166534; color: white; border-color: #166534; }

  .btn-action-red { color: #9f1239; border-color: #fecdd3; background: #fff1f2; }
  .btn-action-red:hover { background: #9f1239; color: white; border-color: #9f1239; }

  /* LIGNE TOTAL */
  .total-row td {
    padding: 12px 16px;
    border-top: 2px solid #e8e6e3;
    background: #f5f4f1 !important;
    font-size: 13px;
    font-weight: 700;
    color: #0f2540;
  }

  /* MODAL LOCATAIRE */
  .tenant-modal {
    position: fixed;
    inset: 0;
    background: rgba(15,37,64,0.4);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .tenant-modal-content {
    background: white;
    border-radius: 14px;
    width: 90%;
    max-width: 520px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 12px 40px rgba(0,0,0,0.15);
  }

  .tenant-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 0.5px solid #e8e6e3;
    background: #faf9f7;
    border-radius: 14px 14px 0 0;
  }

  .tenant-modal-header h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: #0f2540;
  }

  .tenant-modal-close {
    background: #e8e6e3;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0f2540;
    transition: background 0.2s;
    font-size: 14px;
  }

  .tenant-modal-close:hover { background: #d1d5db; }

  .tenant-modal-body { padding: 1.5rem; }

  .tenant-modal-body .form-group { margin-bottom: 1rem; }

  .tenant-modal-body .form-label {
    display: block;
    margin-bottom: 0.35rem;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #9ca3af;
  }

  .tenant-modal-body .form-input,
  .tenant-modal-body .form-textarea {
    width: 100%;
    padding: 0.6rem 0.875rem;
    font-size: 13px;
    font-family: inherit;
    border: 1px solid #e0ddd8;
    border-radius: 8px;
    background: #fafbfc;
    box-sizing: border-box;
    transition: border-color 0.2s;
  }

  .tenant-modal-body .form-input:focus,
  .tenant-modal-body .form-textarea:focus {
    outline: none;
    border-color: #0f2540;
    background: white;
  }

  .tenant-modal-body .form-textarea {
    resize: vertical;
    min-height: 90px;
  }

  .tenant-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 0.5px solid #e8e6e3;
  }

  .tenant-modal-actions .btn {
    padding: 0.6rem 1.25rem;
    font-size: 13px;
    font-family: inherit;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    border: none;
  }

  .tenant-modal-actions .btn-secondary {
    background: white;
    color: #6b7280;
    border: 1px solid #e0ddd8;
  }

  .tenant-modal-actions .btn-primary {
    background: #0f2540;
    color: white;
  }

  @media (max-width: 768px) {
    .cal-header h1 { font-size: 1.2rem; }
    .cal-kpis { grid-template-columns: 1fr; }
    .cal-table { font-size: 11px; }
    .cal-table th, .cal-table td { padding: 8px; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Vérifier l'authentification
    const auth = sessionStorage.getItem('chalet_admin_auth');
    if (auth !== 'authenticated') {
      window.location.href = '/login';
      return;
    }

    // Fonction pour obtenir le premier samedi de décembre
    function getFirstSaturdayOfDecember(year: number): Date {
      const firstDay = new Date(year, 11, 1); // Décembre = mois 11
      const dayOfWeek = firstDay.getDay(); // 0 = Dimanche, 6 = Samedi
      // Trouver le premier samedi de décembre
      // Si c'est déjà samedi, prendre le 1er
      // Sinon, aller au samedi suivant
      let daysToAdd;
      if (dayOfWeek === 6) {
        daysToAdd = 0; // C'est déjà samedi
      } else {
        // Calculer les jours jusqu'au prochain samedi
        // Si dayOfWeek = 0 (dimanche) -> samedi suivant = +6 jours
        // Si dayOfWeek = 1 (lundi) -> samedi suivant = +5 jours
        // Si dayOfWeek = 2 (mardi) -> samedi suivant = +4 jours
        // Si dayOfWeek = 3 (mercredi) -> samedi suivant = +3 jours
        // Si dayOfWeek = 4 (jeudi) -> samedi suivant = +2 jours
        // Si dayOfWeek = 5 (vendredi) -> samedi suivant = +1 jour
        daysToAdd = (6 - dayOfWeek + 7) % 7;
        if (daysToAdd === 0 && dayOfWeek !== 6) {
          daysToAdd = 7;
        }
      }
      const result = new Date(year, 11, 1 + daysToAdd);
      // Vérifier que c'est bien un samedi
      if (result.getDay() !== 6) {
        // Si ce n'est pas un samedi, trouver le prochain samedi
        const currentDay = result.getDay();
        const additionalDays = (6 - currentDay + 7) % 7;
        result.setDate(result.getDate() + additionalDays);
      }
      return result;
    }

    // Fonction pour formater une date
    function formatDate(date: Date): string {
      return date.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' });
    }

    // Fonction pour obtenir le premier samedi de juin
    function getFirstSaturdayOfJune(year: number): Date {
      const firstDay = new Date(year, 5, 1); // Juin = mois 5
      const dayOfWeek = firstDay.getDay(); // 0 = Dimanche, 6 = Samedi
      let daysToAdd;
      if (dayOfWeek === 6) {
        daysToAdd = 0; // C'est déjà samedi
      } else {
        daysToAdd = (6 - dayOfWeek + 7) % 7;
        if (daysToAdd === 0 && dayOfWeek !== 6) {
          daysToAdd = 7;
        }
      }
      const result = new Date(year, 5, 1 + daysToAdd);
      if (result.getDay() !== 6) {
        const currentDay = result.getDay();
        const additionalDays = (6 - currentDay + 7) % 7;
        result.setDate(result.getDate() + additionalDays);
      }
      return result;
    }

    // Fonction pour obtenir toutes les semaines hiver (samedi-samedi de décembre à fin mai)
    function getWinterWeeks(year: number): Array<{ start: Date; end: Date }> {
      const weeks: Array<{ start: Date; end: Date }> = [];
      let currentSaturday = getFirstSaturdayOfDecember(year);
      const endDate = new Date(year + 1, 4, 31); // Fin mai de l'année suivante

      while (currentSaturday <= endDate) {
        const weekEnd = new Date(currentSaturday);
        weekEnd.setDate(weekEnd.getDate() + 6); // Samedi suivant (6 jours plus tard)
        
        // Si la fin de la semaine dépasse la date limite, on arrête
        if (weekEnd > endDate) break;
        
        weeks.push({ 
          start: new Date(currentSaturday), 
          end: new Date(weekEnd) 
        });
        
        // Passer au samedi suivant (7 jours plus tard)
        currentSaturday = new Date(currentSaturday);
        currentSaturday.setDate(currentSaturday.getDate() + 7);
      }

      return weeks;
    }

    // Fonction pour obtenir toutes les semaines été (samedi-samedi de juin à fin août)
    function getSummerWeeks(year: number): Array<{ start: Date; end: Date }> {
      const weeks: Array<{ start: Date; end: Date }> = [];
      let currentSaturday = getFirstSaturdayOfJune(year);
      const endDate = new Date(year, 7, 31); // Fin août (mois 7)

      while (currentSaturday <= endDate) {
        const weekEnd = new Date(currentSaturday);
        weekEnd.setDate(weekEnd.getDate() + 6); // Samedi suivant (6 jours plus tard)
        
        // Si la fin de la semaine dépasse la date limite, on arrête
        if (weekEnd > endDate) break;
        
        weeks.push({ 
          start: new Date(currentSaturday), 
          end: new Date(weekEnd) 
        });
        
        // Passer au samedi suivant (7 jours plus tard)
        currentSaturday = new Date(currentSaturday);
        currentSaturday.setDate(currentSaturday.getDate() + 7);
      }

      return weeks;
    }

    // Générer le calendrier - toujours commencer sur Hiver 25/26
    let currentYear = 2025; // Année fixe pour commencer sur Hiver 25/26
    let isWinter = true; // true = Hiver, false = Été
    const platforms = ['Perso', 'Booking', 'Airbnb', 'Abritel', 'Leboncoin', 'Centrale de résa', 'Chalet Montagne'];

    // Gestion de la modal fiche locataire
    const tenantModal = document.getElementById('tenantModal') as HTMLElement;
    const closeTenantModal = document.getElementById('closeTenantModal');
    const cancelTenantForm = document.getElementById('cancelTenantForm');
    const tenantForm = document.getElementById('tenantForm') as HTMLFormElement;
    let currentWeekKey = '';
    let currentWeekPlateforme = '';

    async function openTenantModal(weekKey: string) {
      currentWeekKey = weekKey;
      currentWeekPlateforme = '';
      
      try {
        // Charger les données depuis l'API SQL
        const season = isWinter ? 'hiver' : 'ete';
        const response = await fetch(`/api/admin/calendar?year=${currentYear}&season=${season}`);
        const data = await response.json();
        
        const weekResa = data.reservations?.[weekKey];
        if (weekResa?.plateforme) currentWeekPlateforme = weekResa.plateforme;

        const weekTenantData = data.tenants[weekKey] || {
          nom: '',
          prenom: '',
          nationalite: '',
          email: '',
          telephone: '',
          note: ''
        };

        // Remplir le formulaire
        (document.getElementById('tenantNom') as HTMLInputElement).value = weekTenantData.nom || '';
        (document.getElementById('tenantPrenom') as HTMLInputElement).value = weekTenantData.prenom || '';
        (document.getElementById('tenantNationalite') as HTMLInputElement).value = weekTenantData.nationalite || '';
        (document.getElementById('tenantEmail') as HTMLInputElement).value = weekTenantData.email || '';
        (document.getElementById('tenantTelephone') as HTMLInputElement).value = weekTenantData.telephone || '';
        (document.getElementById('tenantNote') as HTMLTextAreaElement).value = weekTenantData.note || '';

        // Afficher la modal
        if (tenantModal) {
          tenantModal.style.display = 'flex';
        }
      } catch (error) {
        console.error('Erreur chargement locataire:', error);
        alert('Erreur lors du chargement des données du locataire.');
      }
    }

    function closeModal() {
      if (tenantModal) {
        tenantModal.style.display = 'none';
      }
      currentWeekKey = '';
      currentWeekPlateforme = '';
      if (tenantForm) {
        tenantForm.reset();
      }
    }

    // Event listeners pour fermer la modal
    if (closeTenantModal) {
      closeTenantModal.addEventListener('click', closeModal);
    }

    if (cancelTenantForm) {
      cancelTenantForm.addEventListener('click', closeModal);
    }

    // Fermer la modal en cliquant en dehors
    if (tenantModal) {
      tenantModal.addEventListener('click', (e: Event) => {
        const target = e.target as HTMLElement;
        if (target.classList.contains('tenant-modal')) {
          closeModal();
        }
      });
    }

    // Sauvegarder les données du locataire
    if (tenantForm) {
      tenantForm.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        
        if (!currentWeekKey) return;

        // Récupérer les valeurs du formulaire
        const nom = (document.getElementById('tenantNom') as HTMLInputElement).value;
        const prenom = (document.getElementById('tenantPrenom') as HTMLInputElement).value;
        const nationalite = (document.getElementById('tenantNationalite') as HTMLInputElement).value;
        const email = (document.getElementById('tenantEmail') as HTMLInputElement).value;
        const telephone = (document.getElementById('tenantTelephone') as HTMLInputElement).value;
        const note = (document.getElementById('tenantNote') as HTMLTextAreaElement).value;

        const tenantData = {
          nom,
          prenom,
          nationalite,
          email,
          telephone,
          note
        };

        try {
          // Sauvegarder dans la base de données SQL via l'API
          const response = await fetch('/api/admin/calendar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              year: currentYear,
              season: isWinter ? 'hiver' : 'ete',
              week_key: currentWeekKey,
              type: 'tenant',
              data: tenantData
            })
          });

          if (!response.ok) throw new Error('Erreur lors de la sauvegarde');

          // MISE À JOUR DU CRM CLIENT via l'API (source = plateforme de la semaine)
          const periode = currentWeekKey.replace('_', ' - ');
          const yearShort = currentYear.toString().slice(-2);
          const saisonLabel = isWinter ? `Hiver ${yearShort}/${(currentYear + 1).toString().slice(-2)}` : `Été ${yearShort}`;
          const row = document.querySelector(`tr[data-week-key="${currentWeekKey}"]`);
          const plateformeSelect = row?.querySelector('select[data-field="plateforme"]') as HTMLSelectElement | null;
          const sourcePlateforme = (plateformeSelect?.value || currentWeekPlateforme || '').trim() || 'Non renseigné';
          await fetch('/api/admin/contacts', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              nom: `${nom} ${prenom}`.trim(),
              email: email,
              telephone: telephone,
              periode: periode,
              personnes: '12',
              statut: 'confirme',
              source: sourcePlateforme,
              nationalite: nationalite,
              note: note,
              saison: saisonLabel
            })
          });

          // Fermer la modal
          closeModal();
          
          // Recharger les données pour être sûr
          renderCalendar(currentYear, isWinter);
        } catch (error) {
          console.error('Erreur:', error);
          alert('Erreur lors de l\'enregistrement des données.');
        }
      });
    }

