        btn.addEventListener('click', (e: Event) => {
          const target = e.target.closest('.btn-comment') as HTMLElement;
          const weekKey = target.dataset.week;
          if (weekKey) {
            openTenantModal(weekKey);
          }
        });
      });
    }

