    // Fonction pour mettre à jour le total
    async function updateTotal(year: number, winter: boolean) {
      try {
        const season = winter ? 'hiver' : 'ete';
        const response = await fetch(`/api/admin/calendar?year=${year}&season=${season}`);
        const data = await response.json();
        const savedData = data.reservations || {};
        
        let weeks: Array<{ start: Date; end: Date }>;
        if (winter) {
          weeks = getWinterWeeks(year);
        } else {
          weeks = getSummerWeeks(year);
        }

        let totalRevenue = 0;
        weeks.forEach(week => {
          const weekKey = `${formatDate(week.start)}_${formatDate(week.end)}`;
          const weekData = savedData[weekKey] || { tarif: '', plateforme: '', etat: '' };
          const tarif = parseFloat(weekData.tarif || '0') || 0;
          totalRevenue += tarif;
        });
        
        const totalRow = document.querySelector('.total-row td:nth-child(2)') as HTMLElement;
        if (totalRow) {
          totalRow.textContent = `${totalRevenue.toLocaleString('fr-FR')} €`;
        }
      } catch (error) {
        console.error('Erreur update total:', error);
      }
    }

    async function renderCalendar(year: number, winter: boolean) {
      const tbody = document.getElementById('calendarBody');
      const yearDisplay = document.getElementById('currentYear');
      if (!tbody || !yearDisplay) return;

      const season = winter ? 'hiver' : 'ete';
      let weeks: Array<{ start: Date; end: Date }>;
      let displayTitle: string;

      if (winter) {
        weeks = getWinterWeeks(year);
        const y = year.toString().slice(-2);
        const ny = (year + 1).toString().slice(-2);
        displayTitle = `Hiver ${y}/${ny}`;
      } else {
        weeks = getSummerWeeks(year);
        displayTitle = `Été ${year.toString().slice(-2)}`;
      }

      yearDisplay.textContent = displayTitle;

      let savedData: any = {};
      try {
        const response = await fetch(`/api/admin/calendar?year=${year}&season=${season}`);
        const data = await response.json();
        savedData = data.reservations || {};
      } catch (error) {
        console.error('Erreur chargement calendrier:', error);
      }

      let totalRevenue = 0;
      weeks.forEach(week => {
        const weekKey = `${formatDate(week.start)}_${formatDate(week.end)}`;
        const d = savedData[weekKey] || {};
        totalRevenue += parseFloat(d.tarif || '0') || 0;
      });

      tbody.innerHTML = weeks.map((week) => {
        const weekKey = `${formatDate(week.start)}_${formatDate(week.end)}`;
        const weekData = savedData[weekKey] || { tarif: '', plateforme: '', etat: '' };
        const etat = (weekData.etat || '').trim();

        let rowClass = '';
        let rowStyle = '';
        let etatBadgeHtml = '<span style="color:#9ca3af;">—</span>';

        if (etat === 'Réservé') {
          rowClass = 'row-reserved';
          rowStyle = 'background-color:#fff1f2;';
          etatBadgeHtml = '<span style="background:#ffe4e6;color:#9f1239;font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;">Réservé</span>';
        } else if (etat === 'Disponible') {
          rowClass = 'row-available';
          rowStyle = 'background-color:#f0fdf4;';
          etatBadgeHtml = '<span style="background:#dcfce7;color:#166534;font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;">Disponible</span>';
        } else if (etat === 'Privatisé') {
          rowClass = 'row-privatized';
          rowStyle = 'background-color:#fff7ed;';
          etatBadgeHtml = '<span style="background:#ffedd5;color:#9a3412;font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;">Privatisé</span>';
        }

        const semaineCouleur =
          rowClass === 'row-reserved' ? 'color:#9f1239;' :
          rowClass === 'row-available' ? 'color:#166534;' :
          rowClass === 'row-privatized' ? 'color:#9a3412;' :
          'color:#0f2540;';

        const btnRowStyle = 'background:#f5f4f1;border:1px solid #e0ddd8;border-radius:6px;padding:4px 12px;font-size:12px;font-family:inherit;color:#0f2540;cursor:pointer;font-weight:500;';
        const crmBtn = etat === 'Réservé'
          ? `<button type="button" class="btn-action btn-crm" data-week="${weekKey}" style="${btnRowStyle}">Client</button>`
          : '';

        return `
        <tr class="${rowClass}" data-week-key="${weekKey}" style="${rowStyle}">
          <td style="padding:11px 16px;font-weight:600;font-size:13px;${semaineCouleur}">
            <input type="hidden" class="etat-field" data-week="${weekKey}" data-field="etat" value="${(weekData.etat || '').replace(/"/g, '&quot;')}" />
            ${formatDate(week.start)} – ${formatDate(week.end)}
          </td>
          <td style="padding:11px 16px;text-align:right;">
            <input type="text" class="price-input"
              data-week="${weekKey}" data-field="tarif"
              data-raw-tarif="${(weekData.tarif || '').replace(/"/g, '&quot;')}"
              value="${weekData.tarif ? parseFloat(weekData.tarif).toLocaleString('fr-FR') + ' €' : ''}" placeholder="—" readonly
              style="width:100%;max-width:120px;margin-left:auto;padding:0.3rem 0.5rem;
              border:none;border-bottom:1.5px solid transparent;background:transparent;
              text-align:right;font-size:13px;font-weight:600;font-family:inherit;
              color:#0f2540;display:block;" />
          </td>
          <td style="padding:11px 16px;">
            <select class="calendar-select" data-week="${weekKey}" data-field="plateforme" disabled
              style="max-width:155px;padding:0.3rem 0.5rem;border:none;background:transparent;
              font-size:13px;font-family:inherit;color:#6b7280;appearance:none;display:block;">
              <option value="">—</option>
              ${platforms.map(p => `<option value="${p}" ${weekData.plateforme === p ? 'selected' : ''}>${p}</option>`).join('')}
            </select>
          </td>
          <td style="padding:11px 16px;">${etatBadgeHtml}</td>
          <td style="padding:8px 16px;text-align:center;">
            <div style="display:inline-flex;gap:4px;align-items:center;">
              <button type="button" class="btn-action btn-edit" data-week="${weekKey}" style="${btnRowStyle}">Éditer</button>
              <button type="button" class="btn-action btn-comment" data-week="${weekKey}" style="${btnRowStyle}">Fiche</button>
              ${crmBtn}
              <button type="button" class="btn-action btn-action-green btn-save" data-week="${weekKey}" style="display:none;">✓</button>
              <button type="button" class="btn-action btn-action-red btn-cancel" data-week="${weekKey}" style="display:none;">✕</button>
            </div>
          </td>
        </tr>
      `;
      }).join('') + `
      <tr class="total-row">
        <td style="padding:12px 16px;font-size:11px;font-weight:600;color:#9ca3af;
          text-transform:uppercase;letter-spacing:0.05em;border-top:2px solid #e8e6e3;
          background:#f5f4f1;">Total saison</td>
        <td style="padding:12px 16px;text-align:right;font-size:16px;font-weight:700;
          color:#0f2540;border-top:2px solid #e8e6e3;background:#f5f4f1;">
          ${totalRevenue.toLocaleString('fr-FR')} €
        </td>
        <td colspan="3" style="border-top:2px solid #e8e6e3;background:#f5f4f1;"></td>
      </tr>
    `;

      const originalData: { [key: string]: any } = {};

      tbody.querySelectorAll('.btn-edit').forEach((btn: any) => {
        btn.addEventListener('click', (e: Event) => {
          const target = e.target.closest('.btn-edit') as HTMLElement;
          const weekKey = target.dataset.week;
          if (!weekKey) return;

          const row = target.closest('tr') as HTMLTableRowElement;
          if (!row) return;

          const priceInput = row.querySelector('.price-input[data-field="tarif"]') as HTMLInputElement | null;
          if (priceInput && priceInput.dataset.rawTarif !== undefined) {
            priceInput.value = priceInput.dataset.rawTarif || '';
          }

          const inputs = row.querySelectorAll('.price-input, .calendar-select, .etat-field') as NodeListOf<HTMLInputElement | HTMLSelectElement>;
          originalData[weekKey] = {};
          inputs.forEach(input => {
            const field = input.dataset.field;
            if (field) {
              originalData[weekKey][field] = input.value;
            }
          });

          inputs.forEach(input => {
            input.classList.add('editing');
            if (input.tagName === 'INPUT') {
              (input as HTMLInputElement).readOnly = false;
            } else {
              (input as HTMLSelectElement).disabled = false;
            }
          });

          target.style.display = 'none';
          const saveBtn = row.querySelector('.btn-save') as HTMLElement;
          const cancelBtn = row.querySelector('.btn-cancel') as HTMLElement;
          if (saveBtn) saveBtn.style.display = 'inline-flex';
          if (cancelBtn) cancelBtn.style.display = 'inline-flex';
        });
      });

      tbody.querySelectorAll('.btn-save').forEach((btn: any) => {
        btn.addEventListener('click', async (e: Event) => {
          const target = e.target.closest('.btn-save') as HTMLElement;
          const weekKey = target.dataset.week;
          if (!weekKey) return;

          const row = target.closest('tr') as HTMLTableRowElement;
          if (!row) return;

          const inputs = row.querySelectorAll('.price-input, .calendar-select, .etat-field') as NodeListOf<HTMLInputElement | HTMLSelectElement>;
          const weekDataPayload: any = {};

          inputs.forEach(input => {
            const field = input.dataset.field;
            if (field) {
              weekDataPayload[field] = input.value.trim();
            }
          });

          try {
            const response = await fetch('/api/admin/calendar', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                year: year,
                season: winter ? 'hiver' : 'ete',
                week_key: weekKey,
                type: 'reservation',
                data: weekDataPayload
              })
            });

            if (!response.ok) throw new Error('Erreur sauvegarde');

            renderCalendar(year, winter);
          } catch (error) {
            console.error('Erreur:', error);
            alert('Erreur lors de la sauvegarde.');
          }
        });
      });

      tbody.querySelectorAll('.btn-cancel').forEach((btn: any) => {
        btn.addEventListener('click', (e: Event) => {
          const target = e.target.closest('.btn-cancel') as HTMLElement;
          const weekKey = target.dataset.week;
          if (!weekKey) return;

          const row = target.closest('tr') as HTMLTableRowElement;
          if (!row) return;

          const inputs = row.querySelectorAll('.price-input, .calendar-select, .etat-field') as NodeListOf<HTMLInputElement | HTMLSelectElement>;

          if (originalData[weekKey]) {
            inputs.forEach(input => {
              const field = input.dataset.field;
              if (field && originalData[weekKey][field] !== undefined) {
                input.value = originalData[weekKey][field];
              }
            });
          }

          inputs.forEach(input => {
            input.classList.remove('editing');
            if (input.tagName === 'INPUT') {
              (input as HTMLInputElement).readOnly = true;
            } else {
              (input as HTMLSelectElement).disabled = true;
            }
          });

          const piFmt = row.querySelector('.price-input[data-field="tarif"]') as HTMLInputElement | null;
          if (piFmt && piFmt.dataset.rawTarif !== undefined) {
            const raw = (piFmt.value || '').trim();
            const n = parseFloat(String(raw).replace(/\s/g, '').replace(',', '.'));
            if (raw !== '' && !isNaN(n)) {
              piFmt.dataset.rawTarif = String(n);
              piFmt.value = n.toLocaleString('fr-FR') + ' €';
            } else {
              piFmt.dataset.rawTarif = '';
              piFmt.value = '';
            }
          }

          const saveBtn = row.querySelector('.btn-save') as HTMLElement;
          const cancelBtn = row.querySelector('.btn-cancel') as HTMLElement;
          const editBtn = row.querySelector('.btn-edit') as HTMLElement;
          if (saveBtn) saveBtn.style.display = 'none';
          if (cancelBtn) cancelBtn.style.display = 'none';
          if (editBtn) editBtn.style.display = 'inline-flex';
        });
      });

      updateKpis(weeks, savedData);
      attachCommentButtonListeners();
      attachCrmButtonListeners();
    }

    function updateKpis(weeks: any[], savedData: any) {
      let revenus = 0;
      let reservations = 0;
      weeks.forEach((week: any) => {
        const weekKey = `${formatDate(week.start)}_${formatDate(week.end)}`;
        const d = savedData[weekKey] || {};
        if (d.etat === 'Réservé' || d.etat === 'Privatisé') {
          reservations++;
          revenus += parseFloat(d.tarif || '0') || 0;
        }
      });
      const occupation = weeks.length > 0 ? Math.round((reservations / weeks.length) * 100) : 0;
      const kpiRevenu = document.getElementById('kpiRevenu');
      const kpiOccupation = document.getElementById('kpiOccupation');
      const kpiReservations = document.getElementById('kpiReservations');
      if (kpiRevenu) kpiRevenu.textContent = revenus.toLocaleString('fr-FR') + ' €';
      if (kpiOccupation) kpiOccupation.textContent = occupation + '%';
      if (kpiReservations) kpiReservations.textContent = reservations.toString();
    }

    // Contrôles de navigation - chronologique
    document.getElementById('prevYear')?.addEventListener('click', () => {
      if (isWinter) {
        // Si on est en hiver (ex: Hiver 25/26 = déc 2025 - mai 2026), passer à l'été précédent (Été 25 = juin 2025 - août 2025)
        isWinter = false;
        // currentYear reste le même (2025 pour Été 25)
      } else {
        // Si on est en été (ex: Été 26 = juin 2026 - août 2026), passer à l'hiver précédent (Hiver 25/26 = déc 2025 - mai 2026)
        isWinter = true;
        currentYear--; // Revenir à l'année précédente (2025 pour Hiver 25/26)
      }
      renderCalendar(currentYear, isWinter);
    });

    document.getElementById('nextYear')?.addEventListener('click', () => {
      if (isWinter) {
        // Si on est en hiver (ex: Hiver 25/26 = déc 2025 - mai 2026), passer à l'été suivant (Été 26 = juin 2026 - août 2026)
        isWinter = false;
        currentYear++; // Passer à l'année suivante (2026 pour Été 26)
      } else {
        // Si on est en été (ex: Été 26 = juin 2026 - août 2026), passer à l'hiver suivant (Hiver 26/27 = déc 2026 - mai 2027)
        isWinter = true;
        // currentYear reste le même (2026 pour Hiver 26/27)
      }
      renderCalendar(currentYear, isWinter);
    });

    // Rendre le calendrier initial (toujours Hiver 25/26)
    renderCalendar(currentYear, isWinter);

    // Initialiser la base de données (création des tables si besoin)
    fetch('/api/admin/init-db').catch(err => console.error('Init DB error:', err));
  });
</script>
